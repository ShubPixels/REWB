# Block access to .env and PHPMailer source
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<FilesMatch "\.php$">
    # Allow only contact.php and test-smtp.php
</FilesMatch>

# Optional: Clean URLs (if you want /api/contact instead of .php)
RewriteEngine On
RewriteRule ^contact$ contact.php [L]