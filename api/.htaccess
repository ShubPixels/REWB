# Block .env
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# Allow only POST to contact.php
<Files "contact.php">
    <If "%{REQUEST_METHOD} != 'POST'">
        Order allow,deny
        Deny from all
    </If>
</Files>

# React Router fallback
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]